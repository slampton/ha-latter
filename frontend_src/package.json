{
  "name": "@latter/studio-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript source bundle for Latter Studio (ha-latter)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --no-warnings build.mjs",
    "typecheck": "node --no-warnings build.mjs --typecheck",
    "check": "node --no-warnings build.mjs --check",
    "test:unit": "node --no-warnings --import ./src/lib/node-ts-loader.mjs --test test/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "lit": "3.3.3",
    "typescript": "5.9.3"
  }
}
