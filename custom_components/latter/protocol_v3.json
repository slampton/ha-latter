  "services": {
    "device_hello": {
      "description": "Device-initiated handshake sent when Home Assistant connects to the ESPHome API",
      "fields": ["target_device", "contract", "boot_id", "manifest"]
    },
    "music_browse": {
      "description": "Browse speakers, favorites, playlists, artists, albums, tracks, radio, or search",
      "fields": ["target_device", "mode", "page", "page_size", "speaker", "last_speaker", "search", "album_sort", "artist_album_sort", "podcast_sort"]
    },
    "set_active_speaker": {
      "description": "Select the active media_player target for a Latter device",
      "fields": ["target_device", "entity_id", "transfer_queue"]
    },
    "media_command": {
      "description": "Execute transport, seek, queue, or play_media command on the active speaker",
      "fields": ["target_device", "command", "entity_id", "seek_position", "media_id", "media_type", "enqueue"]
    },
    "media_volume": {
      "description": "Adjust or set volume on the active speaker or volume override target",
      "fields": ["target_device", "entity_id", "action", "volume_level"]
    },
    "area_browse": {
      "description": "Browse Areas, Area domains, or paginated controllable entities",
      "fields": ["target_device", "mode", "area_id", "domain_filter", "page", "page_size", "handoff_media"]
    },
    "area_action": {
      "description": "Execute an explicit domain action on an Area or specific entity",
      "fields": ["target_device", "entity_id", "area_id", "action", "level", "code"]
    },
    "set_active_area": {
      "description": "Set the active Area context for a Latter device",
      "fields": ["target_device", "area_id", "handoff_media"]
    },
    "remote_action": {
      "description": "Send a TV/AV remote command or select active remote slot",
      "fields": ["target_device", "slot", "action", "command"]
    },
    "calendar_fetch": {
      "description": "Refresh upcoming calendar agenda events for a Latter device",
      "fields": ["target_device", "days", "page", "page_size"]
    },
    "calendar_create_event": {
      "description": "Create a new event on the primary configured calendar",
      "fields": ["target_device", "calendar_entity", "summary", "start_date_time", "end_date_time", "in_minutes", "duration_minutes", "description"]
    },
    "intercom_broadcast": {
      "description": "Broadcast a voice announcement across all, occupied, follow_me, or targeted speakers",
      "fields": ["target_device", "message", "media_url", "target_speakers", "tts_entity"]
    },
    "doorbell_intercom": {
      "description": "Control two-way doorbell talkback or trigger explicit lock actions during a doorbell event",
      "fields": ["target_device", "action", "camera_entity", "camera_index", "message", "anc_mode"]
    },
    "save_custom_color": {
      "description": "Save a custom RGB accent color from the on-device color wheel",
      "fields": ["target_device", "hex_color", "name"]
    },
    "notify": {
      "description": "Deliver a visual banner, chime, optional TTS announcement, and optional camera snapshot",
      "fields": ["target_device", "title", "message", "priority", "duration", "chime", "announce", "camera_entity"]
    }
  }
